{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holiday-card",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "public",
    "run_worker_first": ["/api/*", "/album/*"]
  },
  "routes": [{ "pattern": "hi.verynormal.dev", "custom_domain": true }],
  // No <name>.workers.dev URL for production. Each branch gets a preview URL instead: pnpm preview (see AGENTS.md).
  "workers_dev": false,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "holiday-card",
      "database_id": "004f55fd-cb2c-4786-90e3-774604a1578a",
      "migrations_dir": "migrations"
    }
  ],
  // The photo album: web copies of the photos and the page list. Photos never go in git (see AGENTS.md).
  "kv_namespaces": [{ "binding": "ALBUM", "id": "56e7151849254668a1dbbf8b84291659" }],
  "ratelimits": [
    { "name": "PLACES_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "WRITE_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "HOUSEHOLD_LIMIT", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "SPRITE_LIMIT", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
    // The page sends at most one interaction for each egg in 5 seconds, so a guest stays far under this.
    { "name": "INTERACTION_LIMIT", "namespace_id": "1005", "simple": { "limit": 60, "period": 60 } },
    // Each address read or change calls the Apps Script, so a guest gets a few a minute.
    { "name": "ADDRESS_LIMIT", "namespace_id": "1006", "simple": { "limit": 10, "period": 60 } },
    // An invite link reads the Sheet once when it opens. A friend opens it a few times at most.
    { "name": "INVITE_LIMIT", "namespace_id": "1007", "simple": { "limit": 10, "period": 60 } }
  ],
  // Listed here so `wrangler types` does not depend on a local .dev.vars file.
  "secrets": { "required": ["OPENROUTER_API_KEY", "GOOGLE_PLACES_KEY", "SHEET_SECRET"] },
  "vars": {
    "OPENROUTER_MODEL": "anthropic/claude-haiku-5.5",
    "SHEET_URL": "https://script.google.com/macros/s/AKfycbweRjFcUK4fq9j8vZ5HBGFMBd1duKAya3Tq7nhEC8xm6dRWGRPnzKP-DpycDaQ5xgVMFA/exec"
  }
}
