{
  "name": "holiday-card",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "preview": "scripts/preview.sh",
    "deploy": "scripts/deploy.sh",
    "test": "vitest run && node --test test/apps-script.test.mjs",
    "e2e": "node --test --test-concurrency=4 \"test/e2e/*.test.mjs\"",
    "og": "node art/scripts/og.mjs",
    "typecheck": "pnpm types && tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply holiday-card --remote",
    "interactions": "scripts/interactions.sh",
    "sheet:dupes": "node scripts/sheet-dupes.mjs",
    "types": "wrangler types",
    "postinstall": "pnpm types",
    "invite": "node scripts/invite.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
